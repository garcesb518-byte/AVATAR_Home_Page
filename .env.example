# Copy these names into your local .env file or Render Environment settings.
# Never commit the real OpenRouter key.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct
AVATAR_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-netlify-site.netlify.app
